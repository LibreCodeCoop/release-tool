{
  "name": "librecode/release-tool",
  "description": "Production-grade PHP CLI and PHAR for reproducible release automation.",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.5",
    "symfony/console": "^8.1",
    "symfony/yaml": "^8.1",
    "symfony/http-client": "^8.1",
    "symfony/process": "^8.1",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.9"
  },
  "autoload": {
    "psr-4": {
      "LibreCode\\ReleaseTool\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LibreCode\\ReleaseTool\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/release-tool"
  ],
  "scripts": {
    "test": "php vendor-bin/phpunit/vendor/bin/phpunit",
    "test:coverage": "XDEBUG_MODE=coverage php vendor-bin/phpunit/vendor/bin/phpunit --coverage-clover build/coverage.xml",
    "infection": "php vendor-bin/infection/vendor/bin/infection --threads=max --min-msi=75 --min-covered-msi=75",
    "phpstan": "php vendor-bin/phpstan/vendor/bin/phpstan analyse --no-progress",
    "psalm": "php vendor-bin/psalm/vendor/bin/psalm --no-cache",
    "phpmd": "php vendor-bin/phpmd/vendor/bin/phpmd analyze",
    "phpcs": "php vendor-bin/phpcs/vendor/bin/phpcs",
    "cs:check": "php vendor-bin/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php vendor-bin/php-cs-fixer/vendor/bin/php-cs-fixer fix",
    "rector:check": "php vendor-bin/rector/vendor/bin/rector validate-config && php vendor-bin/rector/vendor/bin/rector process --dry-run",
    "deptrac": "php vendor-bin/deptrac/vendor/bin/deptrac analyse --no-progress",
    "qa": [
      "@test",
      "@phpstan",
      "@psalm",
      "@phpmd",
      "@phpcs",
      "@cs:check",
      "@rector:check",
      "@deptrac"
    ],
    "build:phar": "php vendor-bin/box/vendor/bin/box compile",
    "test:phar": [
      "php tools/test-phar.php",
      "php tools/test-publication-phar.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "bamarni-bin": {
      "bin-links": false,
      "forward-command": false
    }
  }
}
