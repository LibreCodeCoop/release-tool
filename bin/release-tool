#!/usr/bin/env php
<?php

declare(strict_types=1);

use LibreCode\ReleaseTool\Application\Artifact\ArtifactRestorer;
use LibreCode\ReleaseTool\Application\Artifact\ArtifactValidator;
use LibreCode\ReleaseTool\Application\Artifact\NextcloudPackageValidator;
use LibreCode\ReleaseTool\Application\Console\ApplicationFactory;
use LibreCode\ReleaseTool\Application\Publication\PublicationVerifier;
use LibreCode\ReleaseTool\Application\Release\LocalReleaseMetadataInspector;
use LibreCode\ReleaseTool\Application\Release\MilestoneTransitioner;
use LibreCode\ReleaseTool\Application\Release\ReleaseDrafter;
use LibreCode\ReleaseTool\Application\Release\ReleaseFinalizer;
use LibreCode\ReleaseTool\Application\Release\ReleasePlanner;
use LibreCode\ReleaseTool\Application\Release\ReleasePreparer;
use LibreCode\ReleaseTool\Application\Release\StableBranchSelector;
use LibreCode\ReleaseTool\Application\Security\RepositoryAuthorizationChecker;
use LibreCode\ReleaseTool\Infrastructure\AppStore\NextcloudAppStoreRepository;
use LibreCode\ReleaseTool\Infrastructure\Archive\PharArchiveReaderFactory;
use LibreCode\ReleaseTool\Infrastructure\Archive\SafeZipExtractor;
use LibreCode\ReleaseTool\Infrastructure\Configuration\LocalConsumerConfigContextValidator;
use LibreCode\ReleaseTool\Infrastructure\Git\LocalGitRepository;
use LibreCode\ReleaseTool\Infrastructure\Git\RemoteStableBranchSource;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubActionsArtifactRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubApiRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubMilestoneRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubPublicationRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubReleaseDraftRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubReleaseFinalizationRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubReleasePreparationPublisher;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubRepositoryPermissionLookup;
use LibreCode\ReleaseTool\Infrastructure\GitHubActions\GitHubActionsEnvironment;
use LibreCode\ReleaseTool\Infrastructure\Release\GitReleaseMetadataReader;

require dirname(__DIR__) . '/vendor/autoload.php';

$root = getcwd() ?: '.';
$git = new LocalGitRepository($root);
$planner = new ReleasePlanner(
    $git,
    GitHubApiRepository::fromEnvironment(),
    new GitReleaseMetadataReader($git),
);

exit(ApplicationFactory::create(
    $planner,
    new LocalConsumerConfigContextValidator(),
    new ReleasePreparer($git),
    GitHubReleasePreparationPublisher::fromEnvironment(),
    $git,
    new LocalReleaseMetadataInspector($git, new GitReleaseMetadataReader($git)),
    new ReleaseFinalizer(
        $git,
        GitHubReleaseFinalizationRepository::fromEnvironment(),
        new GitReleaseMetadataReader($git),
    ),
    new MilestoneTransitioner(
        GitHubMilestoneRepository::fromEnvironment(),
        new GitReleaseMetadataReader($git),
    ),
    new ReleaseDrafter(
        $git,
        GitHubReleaseDraftRepository::fromEnvironment(),
    ),
    new ArtifactValidator(new PharArchiveReaderFactory()),
    new PublicationVerifier(
        GitHubPublicationRepository::fromEnvironment(),
        new NextcloudAppStoreRepository(),
    ),
    new RepositoryAuthorizationChecker(GitHubRepositoryPermissionLookup::fromEnvironment()),
    new StableBranchSelector(new RemoteStableBranchSource()),
    GitHubActionsEnvironment::fromEnvironment(),
    new ArtifactRestorer(GitHubActionsArtifactRepository::fromEnvironment(), new SafeZipExtractor()),
    new NextcloudPackageValidator(new PharArchiveReaderFactory()),
)->run());
