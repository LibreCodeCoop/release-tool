#!/usr/bin/env php
<?php

declare(strict_types=1);

use LibreCode\ReleaseTool\Application\Console\ApplicationFactory;
use LibreCode\ReleaseTool\Application\Release\LocalReleaseMetadataInspector;
use LibreCode\ReleaseTool\Application\Release\ReleaseFinalizer;
use LibreCode\ReleaseTool\Application\Release\ReleasePlanner;
use LibreCode\ReleaseTool\Application\Release\ReleasePreparer;
use LibreCode\ReleaseTool\Infrastructure\Configuration\LocalConsumerConfigContextValidator;
use LibreCode\ReleaseTool\Infrastructure\Git\LocalGitRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubApiRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubReleaseFinalizationRepository;
use LibreCode\ReleaseTool\Infrastructure\GitHub\GitHubReleasePreparationPublisher;
use LibreCode\ReleaseTool\Infrastructure\Release\GitReleaseMetadataReader;

require dirname(__DIR__) . '/vendor/autoload.php';

$root = getcwd() ?: '.';
$git = new LocalGitRepository($root);
$planner = new ReleasePlanner(
    $git,
    GitHubApiRepository::fromEnvironment(),
    new GitReleaseMetadataReader($git),
);

exit(ApplicationFactory::create(
    $planner,
    new LocalConsumerConfigContextValidator(),
    new ReleasePreparer($git),
    GitHubReleasePreparationPublisher::fromEnvironment(),
    $git,
    new LocalReleaseMetadataInspector($git, new GitReleaseMetadataReader($git)),
    new ReleaseFinalizer(
        $git,
        GitHubReleaseFinalizationRepository::fromEnvironment(),
        new GitReleaseMetadataReader($git),
    ),
)->run());
