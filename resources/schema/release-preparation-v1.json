{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LibreCodeCoop/release-tool/resources/schema/release-preparation-v1.json",
  "title": "ReleasePreparation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "release_plan_id", "repository", "target_branch",
    "planning_base_sha", "version", "channel", "mode", "file_changes",
    "changelog", "generated_branch", "pr_marker", "pull_request",
    "merge_preconditions"
  ],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string"},
    "release_plan_id": {"type": "string"},
    "repository": {"type": "string"},
    "target_branch": {"type": "string"},
    "planning_base_sha": {"type": "string"},
    "version": {"type": "string"},
    "channel": {"enum": ["alpha", "beta", "rc", "final"]},
    "mode": {"enum": ["normal", "security"]},
    "file_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before_sha256", "after_sha256"],
        "properties": {
          "path": {"type": "string"},
          "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "changelog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "sha256"],
      "properties": {
        "section": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "generated_branch": {"type": "string"},
    "pr_marker": {"type": "string"},
    "pull_request": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": {"type": "integer"},
        "url": {"type": "string"}
      }
    },
    "merge_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_branch", "expected_base_sha", "allowed_files"],
      "properties": {
        "target_branch": {"type": "string"},
        "expected_base_sha": {"type": "string"},
        "allowed_files": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
