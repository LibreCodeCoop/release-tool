{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LibreCodeCoop/release-tool/resources/schema/consumer-config-v1.json",
  "title": "Release Tool Consumer Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "app", "branches", "version", "history", "changelog", "milestones", "authorization", "package"],
  "properties": {
    "schema": {"const": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "main_branch"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "main_branch": {"type": "string", "minLength": 1}
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_pattern"],
      "properties": {"stable_pattern": {"type": "string", "minLength": 1}}
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tag_prefix"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "mirrors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tag_prefix": {"type": "string"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_release"],
      "properties": {
        "previous_release": {"const": "reachable-tag"},
        "initial_ref": {"type": "string", "minLength": 1}
      }
    },
    "changelog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "path", "package_root"],
      "properties": {
        "strategy": {"const": "per-major"},
        "path": {"type": "string", "minLength": 1},
        "package_root": {"type": "string", "minLength": 1}
      }
    },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "rc"],
      "properties": {
        "patch": {"type": "string", "minLength": 1},
        "rc": {"type": "string", "minLength": 1}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare_min_permission", "merge_min_permission"],
      "properties": {
        "prepare_min_permission": {"enum": ["read", "triage", "write", "maintain", "admin"]},
        "merge_min_permission": {"enum": ["read", "triage", "write", "maintain", "admin"]}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
